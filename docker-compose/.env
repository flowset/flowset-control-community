## Flowset Control configuration ##

# Port where Flowset Control web application is running
FLOWSET_CONTROL_SERVER_PORT=8081

# Configuration of the database used by Flowset control web application
# Note: if the values are changed, don't forget to remove the previous Docker volumes
FLOWSET_CONTROL_DB_NAME=flowset-control
FLOWSET_CONTROL_DB_USERNAME=root
FLOWSET_CONTROL_DB_PASSWORD=root

# Credentials that are set by default on login form
FLOWSET_CONTROL_UI_DEFAULT_USERNAME=
FLOWSET_CONTROL_UI_DEFAULT_PASSWORD=

## Operaton configuration

# Docker image version
OPERATON_RUN_VERSION=latest

# Port where Operaton is running
OPERATON_SERVER_PORT=8082

# Configuration of the database used by Operaton
# Note: if the values are changed, don't forget to remove the previous Docker volumes
OPERATON_DB_NAME=operaton
OPERATON_DB_USERNAME=root
OPERATON_DB_PASSWORD=root

# Admin credentials to log in to Operaton
OPERATON_UI_ADMIN_USERNAME=admin
OPERATON_UI_ADMIN_PASSWORD=admin
