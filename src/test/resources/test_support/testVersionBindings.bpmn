<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_testVersionBindings"
                  targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="testVersionBindings" name="testVersionBindings" isExecutable="true"
                  camunda:historyTimeToLive="180">
        <bpmn:startEvent id="startEvent">
            <bpmn:outgoing>Flow_start_to_callByVersion</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:callActivity id="callByVersionTask" name="Call by version"
                           calledElement="testCalledByVersion"
                           camunda:calledElementBinding="version"
                           camunda:calledElementVersion="2">
            <bpmn:incoming>Flow_start_to_callByVersion</bpmn:incoming>
            <bpmn:outgoing>Flow_callByVersion_to_callByVersionTag</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:callActivity id="callByVersionTagTask" name="Call by version tag"
                           calledElement="testCalledByVersionTag"
                           camunda:calledElementBinding="versionTag"
                           camunda:calledElementVersionTag="v1">
            <bpmn:incoming>Flow_callByVersion_to_callByVersionTag</bpmn:incoming>
            <bpmn:outgoing>Flow_callByVersionTag_to_evaluateByVersion</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:businessRuleTask id="evaluateByVersionTask" name="Evaluate by version"
                               camunda:decisionRef="decision_calledByVersion"
                               camunda:decisionRefBinding="version"
                               camunda:decisionRefVersion="3">
            <bpmn:incoming>Flow_callByVersionTag_to_evaluateByVersion</bpmn:incoming>
            <bpmn:outgoing>Flow_evaluateByVersion_to_evaluateByVersionTag</bpmn:outgoing>
        </bpmn:businessRuleTask>
        <bpmn:businessRuleTask id="evaluateByVersionTagTask" name="Evaluate by version tag"
                               camunda:decisionRef="decision_calledByVersionTag"
                               camunda:decisionRefBinding="versionTag"
                               camunda:decisionRefVersionTag="1.0">
            <bpmn:incoming>Flow_evaluateByVersion_to_evaluateByVersionTag</bpmn:incoming>
            <bpmn:outgoing>Flow_evaluateByVersionTag_to_end</bpmn:outgoing>
        </bpmn:businessRuleTask>
        <bpmn:endEvent id="endEvent">
            <bpmn:incoming>Flow_evaluateByVersionTag_to_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_start_to_callByVersion" sourceRef="startEvent" targetRef="callByVersionTask"/>
        <bpmn:sequenceFlow id="Flow_callByVersion_to_callByVersionTag" sourceRef="callByVersionTask"
                           targetRef="callByVersionTagTask"/>
        <bpmn:sequenceFlow id="Flow_callByVersionTag_to_evaluateByVersion" sourceRef="callByVersionTagTask"
                           targetRef="evaluateByVersionTask"/>
        <bpmn:sequenceFlow id="Flow_evaluateByVersion_to_evaluateByVersionTag" sourceRef="evaluateByVersionTask"
                           targetRef="evaluateByVersionTagTask"/>
        <bpmn:sequenceFlow id="Flow_evaluateByVersionTag_to_end" sourceRef="evaluateByVersionTagTask"
                           targetRef="endEvent"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="testVersionBindings">
            <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
                <dc:Bounds x="152" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="callByVersionTask_di" bpmnElement="callByVersionTask">
                <dc:Bounds x="240" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="callByVersionTagTask_di" bpmnElement="callByVersionTagTask">
                <dc:Bounds x="390" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="evaluateByVersionTask_di" bpmnElement="evaluateByVersionTask">
                <dc:Bounds x="540" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="evaluateByVersionTagTask_di" bpmnElement="evaluateByVersionTagTask">
                <dc:Bounds x="690" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endEvent_di" bpmnElement="endEvent">
                <dc:Bounds x="842" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Flow_start_to_callByVersion_di" bpmnElement="Flow_start_to_callByVersion">
                <di:waypoint x="188" y="120"/>
                <di:waypoint x="240" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_callByVersion_to_callByVersionTag_di"
                             bpmnElement="Flow_callByVersion_to_callByVersionTag">
                <di:waypoint x="340" y="120"/>
                <di:waypoint x="390" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_callByVersionTag_to_evaluateByVersion_di"
                             bpmnElement="Flow_callByVersionTag_to_evaluateByVersion">
                <di:waypoint x="490" y="120"/>
                <di:waypoint x="540" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_evaluateByVersion_to_evaluateByVersionTag_di"
                             bpmnElement="Flow_evaluateByVersion_to_evaluateByVersionTag">
                <di:waypoint x="640" y="120"/>
                <di:waypoint x="690" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_evaluateByVersionTag_to_end_di" bpmnElement="Flow_evaluateByVersionTag_to_end">
                <di:waypoint x="790" y="120"/>
                <di:waypoint x="842" y="120"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
