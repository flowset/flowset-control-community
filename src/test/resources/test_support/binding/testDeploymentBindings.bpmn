<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_testDeploymentBindings"
                  targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="testDeploymentBindings" name="testDeploymentBindings" isExecutable="true"
                  camunda:historyTimeToLive="180">
        <bpmn:startEvent id="startEvent">
            <bpmn:outgoing>Flow_start_to_callByDeployment</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:callActivity id="callByDeploymentTask" name="Call by deployment"
                           calledElement="testCalledByDeployment"
                           camunda:calledElementBinding="deployment">
            <bpmn:incoming>Flow_start_to_callByDeployment</bpmn:incoming>
            <bpmn:outgoing>Flow_callByDeployment_to_evaluateByDeployment</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:businessRuleTask id="evaluateByDeploymentTask" name="Evaluate by deployment"
                               camunda:decisionRef="decision_calledByDeployment"
                               camunda:decisionRefBinding="deployment">
            <bpmn:incoming>Flow_callByDeployment_to_evaluateByDeployment</bpmn:incoming>
            <bpmn:outgoing>Flow_evaluateByDeployment_to_end</bpmn:outgoing>
        </bpmn:businessRuleTask>
        <bpmn:endEvent id="endEvent">
            <bpmn:incoming>Flow_evaluateByDeployment_to_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_start_to_callByDeployment" sourceRef="startEvent"
                           targetRef="callByDeploymentTask"/>
        <bpmn:sequenceFlow id="Flow_callByDeployment_to_evaluateByDeployment" sourceRef="callByDeploymentTask"
                           targetRef="evaluateByDeploymentTask"/>
        <bpmn:sequenceFlow id="Flow_evaluateByDeployment_to_end" sourceRef="evaluateByDeploymentTask"
                           targetRef="endEvent"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="testDeploymentBindings">
            <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
                <dc:Bounds x="152" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="callByDeploymentTask_di" bpmnElement="callByDeploymentTask">
                <dc:Bounds x="240" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="evaluateByDeploymentTask_di" bpmnElement="evaluateByDeploymentTask">
                <dc:Bounds x="390" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endEvent_di" bpmnElement="endEvent">
                <dc:Bounds x="542" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Flow_start_to_callByDeployment_di" bpmnElement="Flow_start_to_callByDeployment">
                <di:waypoint x="188" y="120"/>
                <di:waypoint x="240" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_callByDeployment_to_evaluateByDeployment_di"
                             bpmnElement="Flow_callByDeployment_to_evaluateByDeployment">
                <di:waypoint x="340" y="120"/>
                <di:waypoint x="390" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_evaluateByDeployment_to_end_di" bpmnElement="Flow_evaluateByDeployment_to_end">
                <di:waypoint x="490" y="120"/>
                <di:waypoint x="542" y="120"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
