<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <content>
        <vbox id="rootBox" padding="false">
            <span id="confirmText" text="msg://confirmDialog.text"/>
            <span id="summaryText" classNames="font-semibold"/>
            <vbox id="deploymentInfoBox" padding="false" spacing="false">
                <span id="deploymentNameText" classNames="text-s"/>
                <span id="skipUnchangedText" classNames="text-s"/>
            </vbox>
            <hbox id="existingDefinitionsUnknownBox"
                  visible="false"
                  alignItems="CENTER"
                  themeNames="spacing-s"
                  width="100%">
                <icon id="unknownWarningIcon" icon="WARNING" size="1.25em"/>
                <span id="existingDefinitionsUnknownText" text="msg://existingDefinitionsUnknown"/>
            </hbox>
            <vbox id="sectionsBox" padding="false" width="100%"/>
        </vbox>
    </content>
</fragment>
